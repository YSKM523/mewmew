require "shellwords"

default_platform(:ios)

APP_IDENTIFIER = "com.tensorproxies.mewmew"
MATCH_GIT_URL = "git@github.com:YSKM523/mewmew-certs.git"

platform :ios do
  desc "Build, sign, and upload the next TestFlight build"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APPSTORE_KEY_ID"),
      issuer_id: ENV.fetch("APPSTORE_ISSUER_ID"),
      key_content: ENV.fetch("APPSTORE_P8"),
      is_key_content_base64: false,
      in_house: false
    )

    match(
      type: "appstore",
      readonly: false,
      app_identifier: APP_IDENTIFIER,
      git_url: MATCH_GIT_URL,
      keychain_name: ENV.fetch("MATCH_KEYCHAIN_NAME"),
      keychain_password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD"),
      api_key: api_key
    )

    profile_mapping = Actions.lane_context[
      SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING
    ]
    profile_name = profile_mapping&.fetch(APP_IDENTIFIER, nil)
    UI.user_error!("match did not return an App Store profile for #{APP_IDENTIFIER}") if profile_name.to_s.empty?

    latest_build_number = begin
      latest_testflight_build_number(
        api_key: api_key,
        app_identifier: APP_IDENTIFIER,
        initial_build_number: 0
      )
    rescue StandardError => error
      UI.important("No TestFlight build number is available yet (#{error.message}); starting from 0.")
      0
    end

    build_number = latest_build_number.to_i + 1

    team_id = ENV.fetch("APPSTORE_TEAM_ID")
    build_app(
      project: "Mewmew.xcodeproj",
      scheme: "Mewmew",
      export_method: "app-store",
      codesigning_identity: "Apple Distribution",
      # The build number rides in as a build-setting override rather than via
      # agvtool: the project is regenerated by XcodeGen on every run and has
      # GENERATE_INFOPLIST_FILE enabled, so CFBundleVersion comes from here.
      xcargs: [
        "DEVELOPMENT_TEAM=#{Shellwords.escape(team_id)}",
        "CODE_SIGN_STYLE=Manual",
        "CURRENT_PROJECT_VERSION=#{build_number}",
        "PROVISIONING_PROFILE_SPECIFIER=#{Shellwords.escape(profile_name)}"
      ].join(" "),
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          APP_IDENTIFIER => profile_name
        }
      }
    )

    short_sha = `git rev-parse --short HEAD`.strip
    UI.user_error!("Unable to determine the git short SHA") if short_sha.empty?

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: short_sha
    )
  end
end
