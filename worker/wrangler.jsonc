{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mewmew-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-24",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "REPLACE_WITH_RATE_LIMIT_NAMESPACE_ID"
    }
  ]
}
